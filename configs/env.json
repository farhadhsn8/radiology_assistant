
{
  "paths": {
    "voice_address": "assets/voices",
    "template_address": "assets/templates",
    "prompt_address": "assets/prompts",
    "log_directory": "logs"
  },
  "audio": {
    "format": "mp3",
    "chunk_duration_sec": 30,
    "silence_threshold_db": -40,
    "min_chunk_duration_sec": 0.8,
    "boundary_check_duration_ms": 1000,
    "boundary_extension_ms": 5000
  },
  "models": {
    "speech_recognition": {
      "name": "openai/whisper-base",
      "device": "cpu",
      "language": "en",
      "sampling_rate": 16000
    },
    "llm": {
      "model_name1": "gpt-4o-mini",
      "model_name": "gpt-4o-mini-2024-07-18",
      "base_url": "",
      "temperature": 0.1,
      "api_key": ""
    }
  },
 
  "logging": {
    "level": "INFO",
    "file": "logs/app.log",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  },
  "report_types": {
    "modalities": ["ct", "mri", "ultrasound"],
    "contrast_options": ["contrast", "no_contrast"],
    "anatomy_options": ["abdomen", "abdomen_and_pelvis", "brain", "chest"]
  }
}
